DATABASE_URL=postgresql://stockpesa:stockpesa@localhost:5432/stockpesa
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TTL=15m
REFRESH_TTL=30d
ADJUSTMENT_NOTE_THRESHOLD=10
MPESA_MODE=mock
MPESA_CALLBACK_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
# File storage: STORAGE_DRIVER=local (default) or s3. S3 creds only needed for s3.
STORAGE_DRIVER=local
# STORAGE_DRIVER=s3
# S3_BUCKET=stockpesa-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional FCM HTTP v1 delivery. Keep the service account JSON in a secret manager, not source control.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
