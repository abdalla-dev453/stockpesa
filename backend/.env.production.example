NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/stockpesa?sslmode=require
JWT_ACCESS_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TTL=15m
REFRESH_TTL=30d
CORS_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1
ADJUSTMENT_NOTE_THRESHOLD=10
MPESA_MODE=disabled
MPESA_CALLBACK_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional FCM HTTP v1 delivery: inject the JSON through your deployment secret manager.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
