generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  STOREKEEPER
}

enum MovementType {
  purchase_in
  sale_out
  adjustment
  return_in
  return_out
}

enum PayMethod {
  CASH
  MPESA
  BANK
  CARD
  CREDIT
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  OUT_OF_SEASON
}

model Business {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  type                  String
  phone                 String?
  location              String?
  currency              String                 @default("KES")
  vatEnabled            Boolean                @default(false)
  receiptFooter         String?
  logoUrl               String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  products              Product[]
  variants              ProductVariant[]
  bundles               ProductBundle[]
  bundleItems           BundleItem[]
  unitConversions       UnitConversion[]
  productTags           ProductTag[]
  productTagAssignments ProductTagAssignment[]
  productImages         ProductImage[]
  priceHistory          ProductPriceHistory[]
  categories            Category[]
  customers             Customer[]
  sales                 Sale[]
  alerts                Alert[]
  audits                AuditLog[]
  returns               ReturnRecord[]
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @db.Uuid
  fullName        String
  phone           String    @unique
  email           String    @unique
  passwordHash    String
  refreshHash     String?
  role            Role
  deletedAt       DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id])
  products   Product[]

  @@unique([businessId, name])
}

model Product {
  id                 String                 @id @default(uuid()) @db.Uuid
  businessId         String                 @db.Uuid
  categoryId         String?                @db.Uuid
  name               String
  sku                String?
  barcode            String?
  brand              String?
  description        String?
  unit               String                 @default("piece")
  buyingPrice        Decimal                @db.Decimal(14, 2)
  sellingPrice       Decimal                @db.Decimal(14, 2)
  wholesalePrice     Decimal?               @db.Decimal(14, 2)
  vatRate            Decimal?               @db.Decimal(5, 2)
  minStock           Decimal                @default(0) @db.Decimal(14, 3)
  reorderQty         Decimal?               @db.Decimal(14, 3)
  imageUrl           String?
  active             Boolean                @default(true)
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  business           Business               @relation(fields: [businessId], references: [id])
  category           Category?              @relation(fields: [categoryId], references: [id])
  stock              StockLevel?
  movements          StockMovement[]
  saleItems          SaleItem[]
  stockCountItems    StockCountItem[]
  variants           ProductVariant[]
  bundle             ProductBundle?
  bundleItems        BundleItem[]           @relation("BundleProduct")
  componentInBundles BundleItem[]           @relation("BundleComponent")
  images             ProductImage[]
  unitConversions    UnitConversion[]
  productTags        ProductTagAssignment[]
  priceHistory       ProductPriceHistory[]
  promotionalPrice   Decimal?               @db.Decimal(14, 2)
  promotionStartsAt  DateTime?
  promotionEndsAt    DateTime?
  status             ProductStatus          @default(ACTIVE)
  expiryTracking     Boolean                @default(false)
  batchTracking      Boolean                @default(false)

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([barcode])
  @@index([createdAt])
}

model StockLevel {
  productId  String   @id @db.Uuid
  businessId String   @db.Uuid
  quantity   Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id])

  @@index([businessId])
}

model ProductVariant {
  id                String                 @id @default(uuid()) @db.Uuid
  businessId        String                 @db.Uuid
  productId         String                 @db.Uuid
  name              String
  attributes        Json
  sku               String?
  barcode           String?
  unit              String
  buyingPrice       Decimal                @db.Decimal(14, 2)
  sellingPrice      Decimal                @db.Decimal(14, 2)
  wholesalePrice    Decimal?               @db.Decimal(14, 2)
  promotionalPrice  Decimal?               @db.Decimal(14, 2)
  promotionStartsAt DateTime?
  promotionEndsAt   DateTime?
  minStock          Decimal                @default(0) @db.Decimal(14, 3)
  quantity          Decimal                @default(0) @db.Decimal(14, 3)
  active            Boolean                @default(true)
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  business          Business               @relation(fields: [businessId], references: [id])
  product           Product                @relation(fields: [productId], references: [id])
  movements         VariantStockMovement[]
  saleItems         SaleItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, productId])
}

model VariantStockMovement {
  id             String         @id @default(uuid()) @db.Uuid
  businessId     String         @db.Uuid
  variantId      String         @db.Uuid
  userId         String         @db.Uuid
  quantityChange Decimal        @db.Decimal(14, 3)
  unitCost       Decimal?       @db.Decimal(14, 2)
  reason         String?
  reference      String?
  idempotencyKey String?
  createdAt      DateTime       @default(now())
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([businessId, variantId, createdAt])
}

model ProductBundle {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  productId  String   @unique @db.Uuid
  business   Business @relation(fields: [businessId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

model BundleItem {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @db.Uuid
  bundleProductId String   @db.Uuid
  componentId     String   @db.Uuid
  quantity        Decimal  @db.Decimal(14, 3)
  business        Business @relation(fields: [businessId], references: [id])
  bundle          Product  @relation("BundleProduct", fields: [bundleProductId], references: [id])
  component       Product  @relation("BundleComponent", fields: [componentId], references: [id])

  @@unique([bundleProductId, componentId])
  @@index([businessId, componentId])
}

model UnitConversion {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  productId  String?  @db.Uuid
  fromUnit   String
  toUnit     String
  multiplier Decimal  @db.Decimal(14, 6)
  business   Business @relation(fields: [businessId], references: [id])
  product    Product? @relation(fields: [productId], references: [id])

  @@unique([businessId, productId, fromUnit, toUnit])
  @@index([businessId])
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  productId  String   @db.Uuid
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@index([businessId, productId, sortOrder])
}

model ProductTag {
  id         String                 @id @default(uuid()) @db.Uuid
  businessId String                 @db.Uuid
  name       String
  color      String?
  business   Business               @relation(fields: [businessId], references: [id])
  products   ProductTagAssignment[]

  @@unique([businessId, name])
}

model ProductTagAssignment {
  businessId String     @db.Uuid
  productId  String     @db.Uuid
  tagId      String     @db.Uuid
  business   Business   @relation(fields: [businessId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  tag        ProductTag @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
  @@index([businessId])
}

model ProductPriceHistory {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String   @db.Uuid
  productId         String   @db.Uuid
  userId            String   @db.Uuid
  oldBuyingPrice    Decimal  @db.Decimal(14, 2)
  oldSellingPrice   Decimal  @db.Decimal(14, 2)
  oldWholesalePrice Decimal? @db.Decimal(14, 2)
  buyingPrice       Decimal  @db.Decimal(14, 2)
  sellingPrice      Decimal  @db.Decimal(14, 2)
  wholesalePrice    Decimal? @db.Decimal(14, 2)
  reason            String?
  createdAt         DateTime @default(now())
  business          Business @relation(fields: [businessId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])

  @@index([businessId, productId, createdAt])
}

model StockMovement {
  id             String       @id @default(uuid()) @db.Uuid
  businessId     String       @db.Uuid
  productId      String       @db.Uuid
  userId         String       @db.Uuid
  type           MovementType
  quantityChange Decimal      @db.Decimal(14, 3)
  unitCost       Decimal?     @db.Decimal(14, 2)
  reason         String?
  reference      String?
  supplier       String?
  notes          String?
  idempotencyKey String?
  createdAt      DateTime     @default(now())
  product        Product      @relation(fields: [productId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([productId])
  @@index([createdAt])
}

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  name        String
  phone       String?
  notes       String?
  creditLimit Decimal?  @db.Decimal(14, 2)
  balance     Decimal   @default(0) @db.Decimal(14, 2)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id])
  sales       Sale[]
  payments    Payment[]

  @@index([businessId])
}

model Sale {
  id                 String         @id @default(uuid()) @db.Uuid
  businessId         String         @db.Uuid
  customerId         String?        @db.Uuid
  userId             String         @db.Uuid
  saleNumber         String
  saleDate           DateTime       @default(now())
  subtotal           Decimal        @db.Decimal(14, 2)
  discount           Decimal        @default(0) @db.Decimal(14, 2)
  tax                Decimal        @default(0) @db.Decimal(14, 2)
  total              Decimal        @db.Decimal(14, 2)
  amountPaid         Decimal        @db.Decimal(14, 2)
  balanceDue         Decimal        @default(0) @db.Decimal(14, 2)
  status             String         @default("completed")
  idempotencyKey     String?
  idempotencyPayload String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  business           Business       @relation(fields: [businessId], references: [id])
  customer           Customer?      @relation(fields: [customerId], references: [id])
  items              SaleItem[]
  payments           Payment[]
  returns            ReturnRecord[]
  receipts           Receipt[]

  @@unique([businessId, saleNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([saleDate])
}

model SaleItem {
  id          String          @id @default(uuid()) @db.Uuid
  saleId      String          @db.Uuid
  businessId  String          @db.Uuid
  productId   String          @db.Uuid
  variantId   String?         @db.Uuid
  quantity    Decimal         @db.Decimal(14, 3)
  unit        String?
  stockQuantity Decimal      @db.Decimal(14, 3)
  returnedQty Decimal         @default(0) @db.Decimal(14, 3)
  unitPrice   Decimal         @db.Decimal(14, 2)
  unitCost    Decimal         @db.Decimal(14, 2)
  discount    Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal   Decimal         @db.Decimal(14, 2)
  sale        Sale            @relation(fields: [saleId], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  returns     ReturnItem[]

  @@index([businessId])
  @@index([productId])
}

model ReturnRecord {
  id                 String       @id @default(uuid()) @db.Uuid
  businessId         String       @db.Uuid
  saleId             String       @db.Uuid
  userId             String       @db.Uuid
  reason             String
  total              Decimal      @db.Decimal(14, 2)
  refundAmount       Decimal      @default(0) @db.Decimal(14, 2)
  restock            Boolean      @default(true)
  idempotencyKey     String?
  idempotencyPayload String?
  createdAt          DateTime     @default(now())
  business           Business     @relation(fields: [businessId], references: [id])
  sale               Sale         @relation(fields: [saleId], references: [id])
  items              ReturnItem[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([saleId])
}

model ReturnItem {
  id         String       @id @default(uuid()) @db.Uuid
  returnId   String       @db.Uuid
  saleItemId String       @db.Uuid
  quantity   Decimal      @db.Decimal(14, 3)
  unitPrice  Decimal      @db.Decimal(14, 2)
  lineTotal  Decimal      @db.Decimal(14, 2)
  return     ReturnRecord @relation(fields: [returnId], references: [id])
  saleItem   SaleItem     @relation(fields: [saleItemId], references: [id])

  @@unique([returnId, saleItemId])
}

model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @db.Uuid
  saleId        String   @unique @db.Uuid
  receiptNumber String
  snapshot      Json
  createdAt     DateTime @default(now())
  sale          Sale     @relation(fields: [saleId], references: [id])

  @@unique([businessId, receiptNumber])
  @@index([businessId])
}

model Payment {
  id                 String    @id @default(uuid()) @db.Uuid
  businessId         String    @db.Uuid
  saleId             String?   @db.Uuid
  customerId         String?   @db.Uuid
  method             PayMethod
  amount             Decimal   @db.Decimal(14, 2)
  reference          String?
  status             String    @default("PAID")
  checkoutRequestId  String?   @unique
  settledAt          DateTime?
  idempotencyKey     String?
  idempotencyPayload String?
  createdAt          DateTime  @default(now())
  sale               Sale?     @relation(fields: [saleId], references: [id])
  customer           Customer? @relation(fields: [customerId], references: [id])

  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([createdAt])
}

model StockCount {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @db.Uuid
  userId     String           @db.Uuid
  status     String           @default("open")
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  items      StockCountItem[]

  @@index([businessId])
}

model StockCountItem {
  id           String     @id @default(uuid()) @db.Uuid
  stockCountId String     @db.Uuid
  productId    String     @db.Uuid
  systemQty    Decimal    @db.Decimal(14, 3)
  countedQty   Decimal?   @db.Decimal(14, 3)
  count        StockCount @relation(fields: [stockCountId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])

  @@unique([stockCountId, productId])
}

model Alert {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  productId  String?  @db.Uuid
  userId     String?  @db.Uuid
  kind       String
  title      String?
  body       String?
  data       Json?
  critical   Boolean  @default(false)
  dedupeKey  String?  @unique
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model NotificationPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  businessId           String   @db.Uuid
  userId               String   @db.Uuid
  lowStock             Boolean  @default(true)
  outOfStock           Boolean  @default(true)
  dailySummary         Boolean  @default(true)
  creditSale           Boolean  @default(true)
  customerPayment      Boolean  @default(true)
  debtThresholdEnabled Boolean  @default(true)
  debtThreshold        Decimal  @default(10000) @db.Decimal(14, 2)
  securityAlerts       Boolean  @default(true)
  newSale              Boolean  @default(false)
  marketing            Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([businessId])
}

model DeviceToken {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  platform   String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, userId, active])
}

model PushEvent {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  eventKey   String   @unique
  kind       String
  title      String
  body       String
  data       Json
  status     String   @default("PENDING")
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([businessId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  userId     String   @db.Uuid
  action     String
  entity     String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([createdAt])
}
